{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "engines/research/**/*",
    "infrastructure/**/*",
    "agent/**/*",
    "tests/research-integrity-hardening.test.ts",
    "tests/tavily-search-provider.test.ts",
    "scripts/smoke-test-tavily-research.ts"
  ]
}
